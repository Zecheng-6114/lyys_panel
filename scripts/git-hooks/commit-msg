#!/bin/sh
# lyys-panel commit-msg hook — mechanically enforces CONTRIBUTING.md.
# Install with: sh scripts/install-hooks.sh
#
# Validates the Conventional Commits 1.0.0 format (https://www.conventionalcommits.org/):
#   <type>[(<scope>)][!]: <description, lowercase, no trailing period, <= 72 cols total>
#   <blank line>
#   <body: required, what & why, each line <= 72 cols>
#   <blank line>
#   [BREAKING CHANGE: <description>]
#   Signed-off-by: Name <email>
#
# type  must be one of: feat fix perf refactor docs test build ci chore revert
# scope is optional, lowercase subsystem name (api auth db ui theme ...).
# '!' or a 'BREAKING CHANGE:' footer marks a MAJOR version bump (SemVer).

set -e

MSG_FILE="$1"

# Strip comment lines, trailing whitespace, and collapse trailing blank lines.
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT
sed 's/[[:space:]]*$//' "$MSG_FILE" | grep -v '^[[:space:]]*#' |
  awk 'BEGIN{b=0} /^$/{b=b+1; next} {if(b>0){for(i=0;i<b;i++)print "";b=0} print}' > "$TMP"

fail() {
  echo "" >&2
  echo "=== lyys-panel commit-msg: REJECTED ===" >&2
  echo "$1" >&2
  echo "See CONTRIBUTING.md (section 2) for the required format." >&2
  echo "======================================" >&2
  exit 1
}

[ -s "$TMP" ] || fail "Empty commit message."

SUBJECT="$(sed -n '1p' "$TMP")"

TYPES='feat|fix|perf|refactor|docs|test|build|ci|chore|revert'

# --- Subject checks ---

# Overall shape: type(scope)!: description
if ! printf '%s' "$SUBJECT" | grep -Eq "^($TYPES)(\([a-z][a-z0-9_/-]*\))?!?: .+"; then
  fail "Subject must follow Conventional Commits:
  <type>[(<scope>)][!]: <description>
  type is one of: $TYPES
  scope (optional) is a lowercase subsystem, e.g. feat(api): ... / fix: ...
Got: $SUBJECT"
fi

# Extract the description after the first ': '.
DESC="$(printf '%s' "$SUBJECT" | sed -E "s/^($TYPES)(\([^)]*\))?!?: //")"

# Description must start with a lowercase letter (commitlint subject-case).
first_char="$(printf '%s' "$DESC" | cut -c1)"
case "$first_char" in
  [a-z]) : ;;
  *) fail "Description after ': ' must start with a lowercase letter.
Got: $DESC" ;;
esac

# No trailing period.
case "$DESC" in
  *. | .* ) fail "Subject must not end with a period." ;;
esac

# Header length <= 72 (project choice; keeps git log --oneline readable).
if [ "$(printf '%s' "$SUBJECT" | wc -m)" -gt 72 ]; then
  fail "Subject longer than 72 characters."
fi

# Imperative mood: reject past/continuous tense openers.
if printf '%s' "$DESC" | grep -Eiq '^(added|fixed|removed|updated|changed|refactored|improved|support(ed)?|wip|update|fixes)\b'; then
  fail "Description must use the imperative mood ('add', 'fix', 'remove', ...), not past/continuous tense."
fi

# Vague subjects.
if printf '%s' "$DESC" | grep -Eiq '^(bug fix|some changes|misc|stuff|temp|asdf|test)$'; then
  fail "Subject is too vague to describe a logical change."
fi

# '!' breaking marker requires a BREAKING CHANGE: footer/body line.
if printf '%s' "$SUBJECT" | grep -Eq "^($TYPES)(\([^)]*\))?!: " &&
   ! grep -Eq '^BREAKING CHANGE: ' "$TMP"; then
  fail "Subject uses '!' but the message has no 'BREAKING CHANGE: <description>' line.
Either add it after the body, or drop the '!'."
fi

# --- Body check ---
# Subject must be followed by a blank line.
LINE2="$(sed -n '2p' "$TMP")"
if [ -n "$LINE2" ]; then
  fail "A blank line is required between the subject and the body."
fi

# Body = lines 3..end, minus trailer/footer lines, minus blank lines.
BODY="$(sed -n '3,$p' "$TMP" | grep -Ev '^Signed-off-by: |^BREAKING CHANGE: ' |
  awk 'BEGIN{b=0} /^$/{b=b+1; next} {if(b>0){for(i=0;i<b;i++)print "";b=0} print}')"
if [ -z "$BODY" ]; then
  fail "Commit body is required: explain WHAT changed and WHY (at least one line)."
fi

# Body lines <= 72 columns.
if printf '%s\n' "$BODY" | awk 'length > 72 {print; found=1} END{exit !found}' | grep -q .; then
  long_line="$(printf '%s\n' "$BODY" | awk 'length > 72 {print; exit}')"
  fail "Body line exceeds 72 columns (wrap manually):
$long_line"
fi

# --- Trailer check ---
if ! grep -Eq '^Signed-off-by: .+ <[^<>]+@[^<>]+>' "$TMP"; then
  fail "Missing 'Signed-off-by: Name <email>' trailer. Use 'git commit -s'."
fi

exit 0
